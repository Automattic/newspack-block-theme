{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "newspack-block-theme/correction-box",
	"title": "Corrections Box",
	"category": "newspack",
	"description": "A box to display corrections.",
	"attributes": {},
	"supports": {
		"html": false,
		"color": {
			"gradients": true,
			"__experimentalDefaultControls": {
			"background": true,
			"text": true,
			"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"usesContext": [ "postId" ],
	"textdomain": "newspack-block-theme"
}
